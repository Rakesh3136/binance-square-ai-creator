{
  "version": 2,
  "enabled": true,
  "autonomous_business_layer": true,
  "max_files_per_cycle": 4,
  "max_changed_lines_per_file": 300,
  "allowed_prefixes": [
    "src/editorial_preflight.py",
    "src/engagement_engine.py",
    "src/creator_intelligence.py",
    "src/analytics_optimizer.py",
    "src/multi_agent_creator.py",
    "src/visual_renderer.py",
    "src/engagement_quality_gate.py",
    "src/feedback_loop.py",
    "src/metrics_integrity.py",
    "src/distribution_timing_engine.py",
    "src/editorial_brain.py",
    "src/editorial_portfolio.py",
    "src/content_researcher.py",
    "src/hook_engine.py",
    "src/experiment_engine.py",
    "src/revenue_optimizer.py",
    "prompts/",
    "config/"
  ],
  "blocked_prefixes": [
    ".github/workflows/",
    ".github/actions/",
    "binance-skills-hub/",
    ".env",
    "secrets/",
    "data/live/creator_status.json"
  ],
  "blocked_tokens": [
    "BINANCE_SQUARE_OPENAPI_KEY",
    "GEMINI_API_KEY",
    "OPENAI_API_KEY",
    "PRIVATE_KEY",
    "ACCESS_TOKEN"
  ],
  "business_autonomy": {
    "can_change_prompts": true,
    "can_change_content_strategy": true,
    "can_change_editorial_scoring": true,
    "can_change_visual_strategy": true,
    "can_change_experiments": true,
    "can_change_posting_frequency": true,
    "can_change_revenue_strategy": true,
    "can_change_publishing_behavior": true,
    "can_create_new_creator_modules": true
  },
  "security_boundary": {
    "credentials_are_runtime_inputs": true,
    "cannot_reveal_or_rewrite_credentials": true,
    "cannot_disable_secret_scanning": true,
    "cannot_remove_emergency_stop": true
  },
  "auto_merge": true,
  "minimum_complete_metrics": 5,
  "cooldown_hours": 12,
  "one_major_variable_per_cycle": true,
  "require_validation": true
}
