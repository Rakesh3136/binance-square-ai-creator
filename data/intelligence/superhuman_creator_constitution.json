{
  "version": "1.0",
  "mission": "Maximize truthful reader value, authentic attention, durable follower growth and eligible monetization per publication.",
  "north_star": "Speed + verification + original synthesis + visual clarity + memory + follow-up.",
  "default_action": "WAIT_UNLESS_EXPECTED_VALUE_IS_HIGH",
  "hard_principles": [
    "Truth before virality",
    "Reader value before publication volume",
    "Original synthesis before headline repetition",
    "Evidence before certainty",
    "Useful conversation before engagement bait",
    "Authentic influence before monetization",
    "Repair deterministic failures automatically",
    "Regenerate creative failures rather than weakening gates",
    "Learn from every publication",
    "Never manufacture engagement"
  ],
  "candidate_requirement": {
    "minimum_distinct_angles": 5,
    "overall_score": 88,
    "evidence": 85,
    "reader_value": 85,
    "specificity": 85,
    "originality": 82,
    "hook": 82
  },
  "content_formula": [
    "specific hook",
    "verified evidence",
    "non-obvious interpretation",
    "counterpoint or invalidation condition",
    "what to watch next",
    "one genuine question"
  ],
  "reject_if": [
    "generic or reusable for almost any coin",
    "headline is repeated without added insight",
    "unsupported certainty",
    "fabricated facts",
    "repetitive hook",
    "fake urgency",
    "empty engagement bait",
    "decorative visual with no informational purpose",
    "audience saturation without new evidence",
    "posting only to satisfy cadence"
  ],
  "opportunity_types": [
    "breaking_verified_event",
    "market_anomaly",
    "contrarian_evidence",
    "narrative_vs_data_conflict",
    "under_covered_mechanism",
    "event_triggered_explainer",
    "decision_useful_comparison",
    "risk_counterpoint",
    "follow_up_with_new_evidence",
    "original_research"
  ],
  "learning_metrics": [
    "views",
    "meaningful_engagement",
    "follows",
    "cashtag_or_widget_interactions",
    "qualified_downstream_activity",
    "earnings",
    "creatorpad_points_or_rank",
    "topic_efficiency",
    "hook_efficiency",
    "reader_question_themes"
  ],
  "cadence": {
    "wake_frequency": "hourly_or_better_when_available",
    "posting_frequency": "adaptive",
    "breaking_event_override": true,
    "forced_three_hour_posting": false
  }
}
